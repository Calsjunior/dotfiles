{
  "Starter Template": {
    "prefix": "set",
    "body": [
      "#set page(paper: \"a4\")",
      "#set par(justify: true)",
      "#set text(font: \"Libertinus Serif\", size: 11pt)",
      "#set heading(numbering: \"1.\")"
    ]
  },
  "Code Figure": {
    "prefix": "codefig",
    "body": [
      "#figure(",
      "  ```${1:python}",
      "  ${2:# Your code here}",
      "  ```,",
      "  caption: [${3:Caption text}]",
      ") <lst_${4:label}>$0"
    ],
    "description": "Code block wrapped in a figure with caption and label"
  },
  "Include Subfile": {
    "prefix": "inc",
    "body": ["#include \"${1:lectures/01-intro}.typ\"$0"],
    "description": "Include a modular file"
  },
  "Equation with Label": {
    "prefix": "eql",
    "body": ["$ ${1:E = mc^2} $ <eq_${2:label}>$0"],
    "description": "Centered display equation with a label for cross-referencing"
  },
  "Piecewise Function (Cases)": {
    "prefix": "cases",
    "body": [
      "$ ${1:f(x)} = cases(",
      "  ${2:1} \"if\" ${3:x > 0},",
      "  ${4:0} \"otherwise\"",
      ") $ $0"
    ],
    "description": "Piecewise mathematical function"
  },
  "Matrix": {
    "prefix": "mat",
    "body": ["$ mat(", "  ${1:1}, ${2:0} ;", "  ${3:0}, ${4:1}", ") $ $0"],
    "description": "2D Math Matrix"
  },
  "Two Column Grid": {
    "prefix": "grid2",
    "body": [
      "#grid(",
      "  columns: (1fr, 1fr),",
      "  gutter: 1em,",
      "  [",
      "    ${1:Left side content}",
      "  ],",
      "  [",
      "    ${2:Right side content}",
      "  ]",
      ")$0"
    ],
    "description": "Side-by-side content (great for comparing code or placing text next to an image)"
  },
  "Basic Table": {
    "prefix": "tbl",
    "body": [
      "#table(",
      "  columns: ${1:2},",
      "  stroke: 0.5pt,",
      "  table.header([*${2:Col 1}*], [*${3:Col 2}*]),",
      "  [${4:Data 1}], [${5:Data 2}],",
      "  [${6:Data 3}], [${7:Data 4}]",
      ")$0"
    ],
    "description": "Standard table with bold headers"
  },
  "Inline Code": {
    "prefix": "ic",
    "body": ["`${1:code}`$0"],
    "description": "Inline raw code formatting"
  },
  "Reference": {
    "prefix": "ref",
    "body": ["@${1:label}$0"],
    "description": "Cross-reference a label"
  },
  "fraction": {
    "prefix": "frac",
    "body": ["$ ${1:numerator} / ${2:denominator} $ $0"]
  },
  "Render Screenshots": {
    "prefix": "render",
    "body": [
      "#let render-screenshots(prefix: \"\", titles: (:)) = {",
      "  let file-list = prefix + \".txt\"",
      "  let content = read(file-list)",
      "",
      "  if content.trim() == \"\" { return }",
      "",
      "  let files = content.trim().split(\"\\n\").filter(f => f.trim() != \"\")",
      "",
      "  for (num, title) in titles.pairs() {",
      "    align(center)[",
      "      #let capitalized-prefix = upper(prefix.slice(0, 1)) + prefix.slice(1)",
      "      #heading(level: 1)[#capitalized-prefix #num: #title]",
      "    ]",
      "",
      "    let target-id = prefix + \"-\" + num + \"-\"",
      "    let target-images = files.filter(f => f.contains(target-id))",
      "",
      "    for file in target-images {",
      "      block(width: 100%, stroke: 0.5pt + luma(200), inset: 5pt)[",
      "        #image(file)",
      "      ]",
      "      v(1em)",
      "    }",
      "  }",
      "}",
      "",
      "// #render-screenshots(",
      "//   prefix: \"${1:task}\",",
      "//   titles: (",
      "//     \"${2:01}\": \"${3:Task 1 Name}\",",
      "//     \"${4:02}\": \"${5:Task 2 Name}\",",
      "//   ),",
      "// )$0"
    ],
    "description": "Macro to load and format screenshot images from text list"
  },
  "Mousse Theorem": {
    "prefix": "thm",
    "body": ["#theorem[", "  ${1:Statement}", "]$0"],
    "description": "Unnamed theorem block"
  },
  "Mousse Named Theorem": {
    "prefix": "thmn",
    "body": ["#theorem(name: \"${1:Name}\")[", "  ${2:Statement}", "]$0"],
    "description": "Named theorem block"
  },
  "Mousse Definition": {
    "prefix": "def",
    "body": ["#definition[", "  ${1:Definition}", "]$0"],
    "description": "Definition block"
  },
  "Mousse Proof": {
    "prefix": "prf",
    "body": ["#proof[", "  ${1:Proof body} $qed", "]$0"],
    "description": "Proof block with QED symbol"
  },
  "Mousse Example": {
    "prefix": "ex",
    "body": ["#example[", "  ${1:Example content}", "]$0"],
    "description": "Example block"
  },
  "Mousse Solution": {
    "prefix": "sol",
    "body": ["#solution[", "  ${1:Solution steps} $qed", "]$0"],
    "description": "Solution block with QED symbol"
  },
  "Mousse Proposition": {
    "prefix": "prop",
    "body": ["#proposition[", "  ${1:Statement}", "]$0"],
    "description": "Proposition block"
  },
  "Mousse Lemma": {
    "prefix": "lem",
    "body": ["#lemma[", "  ${1:Statement}", "]$0"],
    "description": "Lemma block"
  },
  "Mousse Corollary": {
    "prefix": "cor",
    "body": ["#corollary[", "  ${1:Statement}", "]$0"],
    "description": "Corollary block"
  },
  "Mousse Remark": {
    "prefix": "rem",
    "body": ["#remark[", "  ${1:Side note or caveat}", "]$0"],
    "description": "Remark block"
  }
}
