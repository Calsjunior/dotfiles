{
  "Modern CSS Reset": {
    "prefix": "reset",
    "body": [
      "*,",
      "*::before,",
      "*::after {",
      "  box-sizing: border-box;",
      "}",
      "",
      ":where(*:not(dialog)) {",
      "  margin: 0;",
      "}",
      "",
      "body {",
      "  min-inline-size: 100svh;",
      "  max-block-size: 100%;",
      "  font-family:",
      "    system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica,",
      "    Arial, sans-serif;",
      "  font-size: 1rem;",
      "  -webkit-font-smoothing: antialiased;",
      "  line-height: 1.5;",
      "}",
      "",
      ":where(img, picture, video, svg) {",
      "  display: block;",
      "  max-inline-size: 100%;",
      "  height: auto;",
      "}",
      "",
      ":where(input, button, textarea, select) {",
      "  font: inherit;",
      "  color: currentColor;",
      "  word-spacing: inherit;",
      "  letter-spacing: inherit;",
      "}",
      "",
      ":where(p, h1, h2, h3, h4, h5, h6) {",
      "  text-wrap: balance;",
      "  overflow-wrap: break-word;",
      "}",
      "",
      ":where(p) {",
      "  text-wrap: pretty;",
      "}",
      "",
      ":where(ul, ol) {",
      "  padding: 0;",
      "  margin: 0;",
      "  list-style: none;",
      "}",
      "",
      ":where(button) {",
      "  padding: 0;",
      "  cursor: pointer;",
      "  background: none;",
      "  border: 0;",
      "}",
      "",
      ":where(button:disabled) {",
      "  cursor: not-allowed;",
      "}"
    ],
    "description": "Modern CSS Reset"
  }
}
